{
  "appId": "app.hemcan.mobile",
  "appName": "Hemcan",
  "webDir": "www",
  "backgroundColor": "#07111F",
  "ios": {
    "contentInset": "always",
    "backgroundColor": "#07111F",
    "limitsNavigationsToAppBoundDomains": false
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#07111F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#07111F"
    },
    "LocalNotifications": {
      "smallIcon": "ic_stat_hemcan",
      "iconColor": "#5DE3FF"
    },
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DARK"
    }
  },
  "android": {
    "backgroundColor": "#07111F",
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  }
}
